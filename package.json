{
  "name": "better-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --max-warnings=0",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check": "bun run typecheck && bun run lint && bun test",
    "test:browser": "node scripts/test-reader.mjs",
    "test:reader": "node scripts/check-reader.mjs",
    "test:reader:interactions": "node scripts/check-reader-interactions.mjs",
    "benchmark:reader": "node scripts/benchmark-reader.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "^11.0.0",
    "shadcn": "^4.21.5",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
